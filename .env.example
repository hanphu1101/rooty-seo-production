# Copy file này thành .env (cùng thư mục) rồi điền. KHÔNG gửi file .env cho ai, không đưa lên GitHub.

# Lark Developer Console → app của bạn → Credentials & Basic Info
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mã Base: phần sau /base/ trên thanh địa chỉ, ví dụ https://xxx.larksuite.com/base/ABCdef123?table=...  →  ABCdef123
LARK_BASE_TOKEN=

# Lark quốc tế: https://open.larksuite.com   ·   Feishu (Trung Quốc): https://open.feishu.cn
LARK_DOMAIN=https://open.larksuite.com

# Tháng bắt đầu dự án SEO (YYYY-MM) — để tab Việc SEO tính tháng T1…T10, việc trễ
PROJECT_START=2026-11

# Website để crawl và kiểm Technical SEO
SITE_URL=https://rootytrip.com

# (Tuỳ chọn) Khoá PageSpeed Insights API — tạo miễn phí ở Google Cloud Console.
# Không có khoá thì mục Core Web Vitals (T19) hay bị Google giới hạn lượt gọi.
PAGESPEED_API_KEY=

# (Tuỳ chọn) Tự lấy số Search Console + GA4 ở tab B10 — cách tạo xem app/README.md mục "Nối Google Search Console + GA4"
# Điền GOOGLE_SA_KEY=google-key.json sau khi đã lưu file khoá
GOOGLE_SA_KEY=
GSC_SITE=sc-domain:rootytrip.com
GA4_PROPERTY=
